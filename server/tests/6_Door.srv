name="Door"
pre="Close the Door & Door alarms should be off before starting this test"
pass="Door test successfully completed"
fail="Door test failed"

# ==================== TEST CONFIGURATION ====================
# Control variables for the entire test
timeout=20
retryCount=0

# ==================== STEP DEFINITIONS ====================
# Each step has: msg, waitFor, waitTime, expectedValue, onPass, onFail

[step:1]
msg="Open the Door"
waitFor="doorStatus"
waitTime=20
expectedValue="OPEN"
onPass="Door alarm triggered successfully"
onFail="Door alarm did not trigger within time"

[step:2]
msg="Close the Door"
waitFor="doorStatus"
waitTime=20
expectedValue="CLOSED"
onPass="Door alarm went off successfully"
onFail="Door alarm did not go off within time"