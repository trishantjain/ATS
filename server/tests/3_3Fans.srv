name="3 Fan Test"
pre="Shut down all Fans"
pass="Door test successfully completed"
fail="Door test failed"

# ==================== TEST CONFIGURATION ====================
# Control variables for the entire test
timeout=20
retryCount=0

# ==================== STEP DEFINITIONS ====================
# Each step has: msg, waitFor, waitTime, expectedValue, onPass, onFail

[step:1]
msg="Turn on FG1"
waitFor="fanLevel1Running"
waitTime=20
expectedValue="true"
onPass="Fan Group 1 turned on successfully"
onFail="Fan Group 1 not turned on"

[step:2]
msg="Turn off FG1"
waitFor="fanLevel1Running"
waitTime=20
expectedValue="false"
onPass="Fan Group 1 turned off successfully"
onFail="Fan Group 1 not turned off"