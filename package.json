{
  "name": "ats-desktop",
  "version": "1.0.0",
  "description": "ATS desktop application",
  "main": "electron/main.js",
  "scripts": {
    "electron": "electron .",
    "build:frontend": "npm run build --prefix iot-dashboard-frontend",
    "dist": "npm run build:frontend && electron-builder",
    "dist:win": "npm run build:frontend && electron-builder --win",
    "dist:mac": "npm run build:frontend && electron-builder --mac",
    "dist:linux": "npm run build:frontend && electron-builder --linux",
    "install-al": "npm install && cd server && npm install"
  },
  "dependencies": {
    "@serialport/parser-readline": "^13.0.0",
    "axios": "^1.17.0",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.3",
    "readline": "^1.3.0",
    "serialport": "^12.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.0",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.ats.desktop",
    "productName": "ATS",
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server"
      },
      {
        "from": "server/node_modules",
        "to": "server/node_modules"
      },
      {
        "from": "iot-dashboard-frontend/build",
        "to": "iot-dashboard-frontend/build"
      },
      {
        "from": "scripts",
        "to": "scripts"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "directories": {
      "output": "release"
    }
  }
}